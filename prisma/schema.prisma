// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  password        String?
  name            String?
  image           String?
  phone           String?
  
  // Account status
  isActive        Boolean   @default(true)
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  
  // Roles
  roles           Role[]    @relation("UserRoles")
  
  // Profile
  profile         UserProfile?
  
  // Auth
  accounts        Account[]
  sessions        Session[]
  verificationTokens VerificationToken[]
  
  // Subscriptions
  subscriptions   Subscription[]
  
  // Referral
  referralCode    String?   @unique
  referredBy      String?   @db.Char(32)
  referrer        User?     @relation("ReferredUsers", fields: [referredBy], references: [id])
  referredUsers   User[]    @relation("ReferredUsers")
  referralMetrics ReferralMetric?
  referralRewards ReferralReward[]
  
  // Content interactions
  favorites       Favorite[]
  bookmarks       Bookmark[]
  viewHistory     ViewHistory[]
  playlists       Playlist[]
  comments        Comment[]
  ratings         Rating[]
  
  // Admin
  createdBy       String?
  updatedBy       String?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? // Soft delete
  
  // Indexes
  @@index([email])
  @@index([referralCode])
  @@index([isActive])
  @@index([createdAt])
  @@fulltext([email, name]) // MySQL specific - remove for PostgreSQL
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())
  
  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      TokenType
  expires   DateTime
  userId    String?
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  
  @@unique([email, token])
  @@index([email])
  @@index([token])
  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  permissions String[]  @default([]) // JSON array of permission names
  isActive    Boolean   @default(true)
  
  users       User[]    @relation("UserRoles")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([name])
}

model UserProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  
  // Personal Info
  firstName       String?
  lastName        String?
  dateOfBirth     DateTime?
  gender          Gender?
  bio             String?   @db.Text
  profilePhoto    String?
  
  // Location
  country         String?
  state           String?
  city            String?
  zipCode         String?
  timezone        String?   @default("UTC")
  
  // Preferences
  meditationLevel MeditationLevel @default(BEGINNER)
  yogaLevel       YogaLevel       @default(BEGINNER)
  dailyReminder   Boolean   @default(true)
  reminderTime    String?   @default("08:00") // HH:MM format
  
  // Notification Preferences
  emailNotifications    Boolean @default(true)
  pushNotifications     Boolean @default(true)
  smsNotifications      Boolean @default(false)
  marketingEmails       Boolean @default(true)
  weeklyDigest          Boolean @default(true)
  
  // Language & Privacy
  language        String    @default("en")
  privacyLevel    PrivacyLevel @default(PRIVATE)
  showProfile     Boolean   @default(false)
  
  // Settings
  twoFactorEnabled Boolean  @default(false)
  darkMode        Boolean  @default(true)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([country])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MeditationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum YogaLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

// ============================================================================
// SUBSCRIPTION & PAYMENT
// ============================================================================

model SubscriptionPlan {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?   @db.Text
  slug            String    @unique
  
  // Pricing
  monthlyPrice    Float
  halfYearlyPrice Float?
  yearlyPrice     Float?
  currency        String    @default("USD")
  
  // Features
  videoAccess     Boolean   @default(true)
  audioAccess     Boolean   @default(true)
  liveSessionAccess Boolean @default(false)
  downloadAccess  Boolean   @default(false)
  adFree          Boolean   @default(false)
  priority        Int       @default(0)
  
  // Status
  isActive        Boolean   @default(true)
  displayOrder    Int       @default(0)
  
  // Features (JSON)
  features        String[]  @default([])
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  subscriptions   Subscription[]
  
  @@index([slug])
  @@index([isActive])
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String
  planId          String
  
  // Duration
  planDuration    PlanDuration
  startDate       DateTime
  endDate         DateTime
  
  // Status
  status          SubscriptionStatus @default(ACTIVE)
  autoRenew       Boolean   @default(true)
  
  // Pricing snapshot
  amount          Float
  currency        String
  
  // Trial
  trialEnds       DateTime?
  isTrialActive   Boolean   @default(false)
  
  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  payments        Payment[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime?
  
  @@unique([userId, planId]) // One active subscription per plan per user
  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([endDate])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
  CANCELLED
  SUSPENDED
}

enum PlanDuration {
  MONTHLY
  HALF_YEARLY
  YEARLY
}

model Payment {
  id              String    @id @default(cuid())
  subscriptionId  String
  
  // Payment Details
  amount          Float
  currency        String
  paymentMethod   PaymentMethod
  status          PaymentStatus
  
  // Gateway Details
  transactionId   String?   @unique // Stripe/Razorpay ID
  receiptUrl      String?
  invoiceId       String?   @unique
  
  // Retry Info
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  
  // Metadata
  metadata        String?   @db.Text // JSON
  errorMessage    String?
  
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([subscriptionId])
  @@index([transactionId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  WALLET
  BANK_TRANSFER
  GOOGLE_PAY
  APPLE_PAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  DISPUTED
}

model Transaction {
  id              String    @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Float
  currency        String    @default("USD")
  status          TransactionStatus
  
  // Reference
  paymentId       String?
  referenceId     String?
  
  // Description
  description     String?
  metadata        String?   @db.Text
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  SUBSCRIPTION_PURCHASE
  SUBSCRIPTION_UPGRADE
  SUBSCRIPTION_RENEWAL
  REFUND
  CREDIT_APPLIED
  CREDIT_DEDUCTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

// ============================================================================
// REFERRAL PROGRAM
// ============================================================================

model ReferralCode {
  id              String    @id @default(cuid())
  code            String    @unique
  userId          String?
  type            ReferralCodeType @default(PERSONAL)
  
  // Usage tracking
  usageCount      Int       @default(0)
  usageLimit      Int?      // null = unlimited
  
  // Status
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  
  // Commission
  commissionRate  Float     @default(10) // Percentage
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, type])
  @@index([code])
  @@index([isActive])
}

enum ReferralCodeType {
  PERSONAL
  PROMO
  CAMPAIGN
}

model Referral {
  id              String    @id @default(cuid())
  referrerId      String    // User who referred
  referredId      String    // User who was referred
  referralCode    String    // The code used
  
  // Status
  status          ReferralStatus @default(REGISTERED)
  
  // Rewards
  referrerReward  Float     @default(0)
  referredReward  Float     @default(0)
  
  // Tracking
  registeredAt    DateTime? // When referred user registered
  subscribedAt    DateTime? // When referred user subscribed
  activatedAt     DateTime? // When referred user became active
  
  // Metadata
  metadata        String?   @db.Text
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@index([createdAt])
}

enum ReferralStatus {
  REGISTERED
  SUBSCRIBED
  ACTIVE
  INACTIVE
}

model ReferralMetric {
  id              String    @id @default(cuid())
  userId          String    @unique
  
  // Counts
  totalInvites    Int       @default(0)
  registeredCount Int       @default(0)
  subscribedCount Int       @default(0)
  activeCount     Int       @default(0)
  
  // Rewards
  totalEarned     Float     @default(0)
  totalRedeemed   Float     @default(0)
  availableBalance Float    @default(0)
  
  // Levels
  level1Count     Int       @default(0)
  level2Count     Int       @default(0)
  level3Count     Int       @default(0)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
}

model ReferralReward {
  id              String    @id @default(cuid())
  userId          String
  referralId      String?
  amount          Float
  type            RewardType
  status          RewardStatus @default(PENDING)
  
  // Payout
  payoutId        String?
  payoutAt        DateTime?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum RewardType {
  REFERRER_BONUS
  REFERRED_BONUS
  LEVEL_2_BONUS
  LEVEL_3_BONUS
  MILESTONE_BONUS
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
  PAID_OUT
  EXPIRED
}

model ReferralCommissionConfig {
  id              String    @id @default(cuid())
  name            String
  description     String?
  
  // Commission tiers
  level1Percent   Float     @default(10)
  level2Percent   Float     @default(5)
  level3Percent   Float     @default(2)
  
  // Conditions
  minRefAmount    Float     @default(0) // Minimum subscription amount for reward
  maxReward       Float?    // Maximum reward per referral
  validityDays    Int       @default(365)
  
  // Status
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================================
// CONTENT MANAGEMENT
// ============================================================================

model Instructor {
  id              String    @id @default(cuid())
  name            String
  bio             String?   @db.Text
  profileImage    String?
  specialization  String[]  @default([])
  experience      Int?      // Years
  qualifications  String?
  languages       String[]  @default(["en"])
  socialLinks     String?   @db.Text // JSON
  
  isActive        Boolean   @default(true)
  
  videos          Video[]
  audios          Audio[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  @@index([isActive])
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?   @db.Text
  icon            String?
  color           String?
  displayOrder    Int       @default(0)
  
  isActive        Boolean   @default(true)
  
  videos          Video[]
  audios          Audio[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([slug])
  @@index([isActive])
}

model Tag {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  
  videos          Video[]   @relation("VideoTags")
  audios          Audio[]   @relation("AudioTags")
  
  createdAt       DateTime  @default(now())
  
  @@index([slug])
}

model Video {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  thumbnail       String?
  
  // Content Details
  duration        Int       // In seconds
  difficulty      ContentDifficulty
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      String
  tags            Tag[]     @relation("VideoTags")
  
  // Instructor
  instructor      Instructor @relation(fields: [instructorId], references: [id])
  instructorId    String
  
  // Media
  videoUrl        String    @db.Text // S3/R2 key, NOT direct URL
  videoSize       BigInt?   // In bytes
  format          String?   // mp4, webm, etc.
  resolution      String?   // 1080p, 720p, etc.
  
  // Metadata
  language        String    @default("en")
  subtitles       SubtitleInfo[] @db.Text @default([]) // JSON array
  thumbnail_hd    String?
  trailer         String?
  
  // Access Control
  requiresSubscription Boolean @default(true)
  subscriptionLevel String[] @default([])
  
  // Engagement
  views           Int       @default(0)
  likes           Int       @default(0)
  rating          Float?    @default(0) // Average rating
  ratingCount     Int       @default(0)
  
  // Publishing
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  
  // Status
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  
  // Admin
  createdBy       String?
  updatedBy       String?
  
  // Relationships
  favorites       Favorite[]
  bookmarks       Bookmark[]
  viewHistory     ViewHistory[]
  ratings         Rating[]    @relation("VideoRatings")
  comments        Comment[]   @relation("VideoComments")
  playlistItems   PlaylistItem[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  @@index([slug])
  @@index([instructorId])
  @@index([categoryId])
  @@index([isPublished])
  @@index([isActive])
  @@index([createdAt])
}

model Audio {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  thumbnail       String?
  audioType       AudioType
  
  // Content Details
  duration        Int       // In seconds
  difficulty      ContentDifficulty @default(BEGINNER)
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      String
  tags            Tag[]     @relation("AudioTags")
  
  // Instructor
  instructor      Instructor @relation(fields: [instructorId], references: [id])
  instructorId    String
  
  // Media
  audioUrl        String    @db.Text // S3/R2 key, NOT direct URL
  audioSize       BigInt?   // In bytes
  format          String?   // mp3, aac, etc.
  bitrate         String?   // 128kbps, 320kbps, etc.
  
  // Metadata
  language        String    @default("en")
  lyrics          String?   @db.Text
  
  // Access Control
  requiresSubscription Boolean @default(true)
  subscriptionLevel String[] @default([])
  offlineAvailable Boolean  @default(false) // For PWA cache
  
  // Engagement
  plays           Int       @default(0)
  likes           Int       @default(0)
  rating          Float?    @default(0)
  ratingCount     Int       @default(0)
  
  // Publishing
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  
  // Status
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  
  // Admin
  createdBy       String?
  updatedBy       String?
  
  // Relationships
  favorites       Favorite[]
  bookmarks       Bookmark[]
  playHistory     PlayHistory[]
  ratings         Rating[]    @relation("AudioRatings")
  comments        Comment[]   @relation("AudioComments")
  playlistItems   PlaylistItem[]
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  @@index([slug])
  @@index([instructorId])
  @@index([categoryId])
  @@index([audioType])
  @@index([isPublished])
  @@index([isActive])
}

enum AudioType {
  MEDITATION
  BREATHING_EXERCISE
  MANTRA
  SLEEP_STORY
  SPIRITUAL_TALK
  HEALING_SESSION
}

enum ContentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Favorite {
  id              String    @id @default(cuid())
  userId          String
  videoId         String?
  audioId         String?
  type            FavoriteType
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  audio           Audio?    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  
  @@unique([userId, videoId, audioId]) // Can't have duplicate favorites
  @@index([userId])
  @@index([videoId])
  @@index([audioId])
}

enum FavoriteType {
  VIDEO
  AUDIO
}

model Bookmark {
  id              String    @id @default(cuid())
  userId          String
  videoId         String?
  audioId         String?
  type            BookmarkType
  note            String?
  timestamp       Int?      // For video bookmarks - in seconds
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  audio           Audio?    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, videoId, audioId])
  @@index([userId])
  @@index([videoId])
  @@index([audioId])
}

enum BookmarkType {
  VIDEO
  AUDIO
}

model ViewHistory {
  id              String    @id @default(cuid())
  userId          String
  videoId         String
  
  // Progress
  watchedDuration Int       // In seconds
  completedAt     DateTime?
  isCompleted     Boolean   @default(false)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([isCompleted])
}

model PlayHistory {
  id              String    @id @default(cuid())
  userId          String
  audioId         String
  
  // Progress
  playedDuration  Int       // In seconds
  completedAt     DateTime?
  isCompleted     Boolean   @default(false)
  playCount       Int       @default(1)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audio           Audio     @relation(fields: [audioId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, audioId])
  @@index([userId])
  @@index([audioId])
  @@index([isCompleted])
}

model Rating {
  id              String    @id @default(cuid())
  userId          String
  videoId         String?
  audioId         String?
  
  // Rating
  score           Int       // 1-5
  review          String?   @db.Text
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video?    @relation("VideoRatings", fields: [videoId], references: [id], onDelete: Cascade)
  audio           Audio?    @relation("AudioRatings", fields: [audioId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, videoId, audioId])
  @@index([userId])
  @@index([videoId])
  @@index([audioId])
  @@index([score])
}

model Comment {
  id              String    @id @default(cuid())
  userId          String
  videoId         String?
  audioId         String?
  
  // Content
  text            String    @db.Text
  parentId        String?   // For reply threads
  
  // Status
  isApproved      Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  
  // Engagement
  likes           Int       @default(0)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video?    @relation("VideoComments", fields: [videoId], references: [id], onDelete: Cascade)
  audio           Audio?    @relation("AudioComments", fields: [audioId], references: [id], onDelete: Cascade)
  parent          Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("Replies")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([videoId])
  @@index([audioId])
  @@index([isApproved])
  @@index([createdAt])
}

model Playlist {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?   @db.Text
  thumbnail       String?
  isPublic        Boolean   @default(false)
  
  // Engagement
  viewCount       Int       @default(0)
  likeCount       Int       @default(0)
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           PlaylistItem[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  
  @@index([userId])
  @@index([isPublic])
}

model PlaylistItem {
  id              String    @id @default(cuid())
  playlistId      String
  videoId         String?
  audioId         String?
  
  position        Int       // Order in playlist
  
  playlist        Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video           Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  audio           Audio?    @relation(fields: [audioId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  
  @@unique([playlistId, videoId, audioId])
  @@index([playlistId])
  @@index([videoId])
  @@index([audioId])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id              String    @id @default(cuid())
  userId          String
  type            NotificationType
  
  // Content
  title           String
  message         String    @db.Text
  actionUrl       String?
  
  // Status
  isRead          Boolean   @default(false)
  readAt          DateTime?
  
  // Delivery
  channels        NotificationChannel[] @default([])
  sentAt          DateTime  @default(now())
  
  // Metadata
  metadata        String?   @db.Text
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_RENEWED
  NEW_CONTENT
  REFERRAL_REGISTERED
  REFERRAL_SUBSCRIBED
  REWARD_EARNED
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  DAILY_REMINDER
  ANNOUNCEMENT
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
  SMS
}

// ============================================================================
// AUDIT & LOGGING
// ============================================================================

model AuditLog {
  id              String    @id @default(cuid())
  userId          String?
  action          String
  entityType      String
  entityId        String?
  
  // Changes
  oldValues       String?   @db.Text // JSON
  newValues       String?   @db.Text // JSON
  
  // Request Info
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============================================================================
// SETTINGS & CONFIGURATION
// ============================================================================

model Setting {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String    @db.Text
  description     String?
  isPublic        Boolean   @default(false)
  
  updatedAt       DateTime  @updatedAt
  
  @@index([key])
}

model EmailTemplate {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  subject         String
  template        String    @db.Text // HTML template
  variables       String[]  @default([]) // Placeholder variables
  
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([slug])
}

model CMSPage {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  content         String    @db.Text
  description     String?
  keywords        String?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  
  // Status
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  
  // Admin
  createdBy       String?
  updatedBy       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([slug])
  @@index([isPublished])
}

model Announcement {
  id              String    @id @default(cuid())
  title           String
  message         String    @db.Text
  type            AnnouncementType
  
  // Status
  isActive        Boolean   @default(true)
  publishedAt     DateTime  @default(now())
  expiresAt       DateTime?
  
  // Targeting
  roles           String[]  @default([]) // User roles to target
  plans           String[]  @default([]) // Subscription plans to target
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([isActive])
  @@index([publishedAt])
}

enum AnnouncementType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

// ============================================================================
// ADDITIONAL MODELS
// ============================================================================

model Event {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  thumbnail       String?
  
  // Details
  startTime       DateTime
  endTime         DateTime
  instructorId    String?
  location        String?   // Virtual or physical location
  
  // Capacity
  maxAttendees    Int?
  currentAttendees Int @default(0)
  
  // Status
  isLive          Boolean   @default(false)
  isRecorded      Boolean   @default(false)
  recordingUrl    String?   @db.Text
  
  // Links
  zoomLink        String?
  meetLink        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([startTime])
  @@index([isLive])
}

model Achievement {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  icon            String?
  
  // Type
  type            AchievementType
  
  // Progress
  progress        Int       @default(0)
  targetProgress  Int
  isUnlocked      Boolean   @default(false)
  unlockedAt      DateTime?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([userId])
  @@index([type])
  @@index([isUnlocked])
}

enum AchievementType {
  STREAK
  VIDEOS_WATCHED
  AUDIOS_PLAYED
  REFERRALS
  SUBSCRIPTIONS
  COMMUNITY_ENGAGEMENT
}
