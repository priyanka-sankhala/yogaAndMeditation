# Database
DATABASE_URL="postgresql://user:password@localhost:5432/yoga_meditation_db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"

# JWT
JWT_SECRET="your-jwt-secret-key-min-32-chars"
JWT_EXPIRATION="24h"
REFRESH_TOKEN_EXPIRATION="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AWS S3 Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET_NAME="yoga-wellness-private"
AWS_S3_SIGNED_URL_EXPIRATION="3600"

# Cloudflare R2 Configuration (Alternative to S3)
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_ACCESS_KEY_ID="your-access-key"
# CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-key"
# CLOUDFLARE_R2_BUCKET_NAME="yoga-wellness"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@yogaandmeditation.com"
SMTP_FROM_NAME="Yoga & Meditation"

# Payment Gateway - Stripe
STRIPE_SECRET_KEY="sk_test_your-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-key"
STRIPE_WEBHOOK_SECRET="whsec_your-secret"

# Payment Gateway - Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# Admin
ADMIN_EMAIL="admin@yogaandmeditation.com"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Yoga & Meditation"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Video Upload Configuration
MAX_VIDEO_SIZE="5368709120"
MAX_AUDIO_SIZE="104857600"
MAX_IMAGE_SIZE="10485760"

# Notifications
SUPPORT_EMAIL="support@yogaandmeditation.com"

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""

# Feature Flags
FEATURE_PWA="true"
FEATURE_LIVE_SESSIONS="false"
FEATURE_COMMUNITY_FORUM="false"
FEATURE_WATERMARKING="false"
